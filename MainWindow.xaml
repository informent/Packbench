<Window x:Class="Packbench.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Packbench" Width="1180" Height="760" MinWidth="980" MinHeight="640" Background="{StaticResource Background}" WindowStartupLocation="CenterScreen">
  <Grid Margin="34">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0"><StackPanel><TextBlock Text="Packbench" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock Text="Windows application packaging" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Select a project, review its profile, and create a reproducible release." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,5,0,0"/></StackPanel><TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Text="Offline mode  Â·  No telemetry" Foreground="{StaticResource Muted}" FontSize="12"/></Grid>
    <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Margin="0,28,0,18" Padding="18" Effect="{StaticResource CardShadow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PROJECT FOLDER" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/><TextBox x:Name="ProjectPath" Text="" Background="Transparent" Foreground="{StaticResource Text}" BorderThickness="0" FontSize="15" Padding="0,8,0,0"/><TextBlock x:Name="ProjectHint" Text="Choose a folder containing a .csproj file." Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel><Button Grid.Column="1" Content="Choose folder" Click="ChooseFolder_Click" VerticalAlignment="Center"/></Grid></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,14,0"><TextBlock Text="Release profile" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Configure a reproducible Windows build." Foreground="{StaticResource Muted}" Margin="0,4,0,18"/><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="22" Effect="{StaticResource CardShadow}"><StackPanel><TextBlock Text="TARGET RUNTIME" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/><ComboBox x:Name="Runtime" SelectedIndex="0" Margin="0,8,0,20"><ComboBoxItem Content="Windows 64-bit  Â·  win-x64" Tag="win-x64"/><ComboBoxItem Content="Windows ARM64  Â·  win-arm64" Tag="win-arm64"/><ComboBoxItem Content="Windows 32-bit  Â·  win-x86" Tag="win-x86"/></ComboBox><CheckBox x:Name="SelfContained" IsChecked="True" Content="Self-contained application"/><CheckBox x:Name="SingleFile" IsChecked="True" Content="Bundle into one executable"/><Separator Margin="0,7,0,16" Background="{StaticResource Border}"/><TextBlock Text="APPEARANCE" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/><ComboBox x:Name="Theme" SelectedIndex="0" Margin="0,8,0,10" SelectionChanged="Theme_SelectionChanged"><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/><ComboBoxItem Content="System"/></ComboBox><DockPanel Margin="0,0,0,16"><TextBlock Text="Accent color" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock x:Name="AccentValue" Text="220Â°" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="AccentSlider" Minimum="0" Maximum="360" Value="220" TickFrequency="30" IsSnapToTickEnabled="True" ValueChanged="AccentSlider_ValueChanged" Margin="0,0,0,18"/><Separator Margin="0,0,0,22" Background="{StaticResource Border}"/><StackPanel Orientation="Horizontal"><Button Content="Scan project" Click="Scan_Click"/><Button x:Name="BuildRelease" Content="Build release" Click="Build_Click" Background="{StaticResource Accent}"/><Button x:Name="CancelBuild" Content="Cancel" Click="CancelBuild_Click" IsEnabled="False"/></StackPanel></StackPanel></Border></StackPanel>
      <StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Project health" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Checks before anything is published." Foreground="{StaticResource Muted}" Margin="0,4,0,18"/><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="22" MinHeight="260" Effect="{StaticResource CardShadow}"><StackPanel><TextBlock x:Name="ProjectType" Text="Not scanned" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="HealthText" Text="Choose a folder, then scan it." Foreground="{StaticResource Muted}" Margin="0,7,0,20" TextWrapping="Wrap"/><TextBlock Text="ACTIVITY" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/><ProgressBar x:Name="BuildProgress" Height="4" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Foreground="{StaticResource Accent}" Background="{StaticResource Border}" Margin="0,8,0,0"/><TextBox x:Name="Activity" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="{StaticResource Muted}" BorderThickness="0" Height="86" Margin="0,8,0,0"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="OpenOutput" Content="Open update folder" Click="OpenOutput_Click" IsEnabled="False"/><Button Content="Verify package" Click="VerifyPackage_Click"/><Button Content="View diagnostics" Click="ViewLog_Click"/><Button Content="Check for updates" Click="CheckUpdates_Click"/></StackPanel></StackPanel></Border></StackPanel>
    </Grid>
    <TextBlock Grid.Row="3" Text="Packbench 3.3.0  Â·  Builds stay on this machine  Â·  MIT licensed" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,22,0,0"/>
  </Grid>
</Window>
