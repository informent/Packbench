<Application x:Class="Packbench.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Background" Color="#F3F5F8" />
    <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelAlt" Color="#E9EEF5" />
    <SolidColorBrush x:Key="Border" Color="#D4DCE7" />
    <SolidColorBrush x:Key="Text" Color="#172131" />
    <SolidColorBrush x:Key="Muted" Color="#65748A" />
    <SolidColorBrush x:Key="Accent" Color="#2563D9" />
    <SolidColorBrush x:Key="Good" Color="#16845B" />
    <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="2" Opacity="0.12" Color="#526273" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}" /><Setter Property="FontFamily" Value="Segoe UI" /></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Text}" /><Setter Property="Background" Value="{StaticResource PanelAlt}" /><Setter Property="BorderBrush" Value="{StaticResource Border}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="16,10" /><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FontSize" Value="13" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{StaticResource Text}" /><Setter Property="Background" Value="{StaticResource PanelAlt}" /><Setter Property="BorderBrush" Value="{StaticResource Border}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="8" /><Setter Property="Height" Value="40" /></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{StaticResource Text}" /><Setter Property="Background" Value="{StaticResource PanelAlt}" /><Setter Property="Padding" Value="10,8" /></Style>
    <Style TargetType="CheckBox"><Setter Property="FontSize" Value="13" /><Setter Property="Margin" Value="0,0,0,15" /><Setter Property="Foreground" Value="{StaticResource Text}" /></Style>
  </Application.Resources>
</Application>
